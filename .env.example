# App settings
APP_VERSION=0.1.0
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aipcpp_db

REDIS_URL=redis://localhost:6379/0

# Optional: Add any LLM provider keys you use with litellm
# OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key

# LLM model configuration (recommended defaults)
LITELLM_MODEL=gemini/gemma-4-31b-it
LITELLM_EMBEDDING_MODEL=gemini/gemini-embedding-2
SEARCH_SYNTHESIS_MODEL=gemini/gemma-4-31b-it
